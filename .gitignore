# ==========================================
# 1. ROS 2 构建与安装产物 (最重要)
# ==========================================
# colcon 构建生成的目录
build/
install/
log/

# ==========================================
# 2. C++ 编译中间文件与缓存
# ==========================================
# 编译生成的可执行文件、目标文件
*.o
*.so
*.a
*.out

# CMake 生成的缓存与临时文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# ==========================================
# 3. IDE 与编辑器配置文件
# ==========================================
# VS Code 配置
.vscode/

# CLion 配置
.idea/
cmake-build-*/

# macOS 系统文件
.DS_Store

# ==========================================
# 4. Python 相关 (如果你的包里有 Python 节点)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/